@model CreateContractViewModel

@{
    ViewData["Title"] = "New Contract";
}

<div class="glms-page-header">
    <div>
        <h2 class="glms-page-title">New Contract</h2>
        <p class="glms-page-subtitle">Create a logistics contract and upload the signed PDF agreement.</p>
    </div>
</div>

<div class="glms-panel">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="ClientId" class="form-label">Client</label>
            <select asp-for="ClientId" asp-items="@ViewBag.Clients" class="form-select">
                <option value="">-- Select Client --</option>
            </select>
            <span asp-validation-for="ClientId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatusViewModel>()" class="form-select"></select>
        </div>

        <div class="mb-3">
            <label asp-for="ServiceLevel" class="form-label"></label>
            <input asp-for="ServiceLevel" class="form-control" />
            <span asp-validation-for="ServiceLevel" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SignedAgreement" class="form-label">Signed Agreement (PDF only)</label>
            <input asp-for="SignedAgreement" type="file" accept=".pdf" class="form-control" />
            <span asp-validation-for="SignedAgreement" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
